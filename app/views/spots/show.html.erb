<h1><%= @spot.name %></h1>

<% official_url = safe_external_url(@spot.official_url) %>

<dl>
  <dt>都道府県</dt>
  <dd><%= @spot.prefecture %></dd>

  <dt>市区町村</dt>
  <dd><%= @spot.city %></dd>

  <dt>住所</dt>
  <dd><%= @spot.address %></dd>

  <dt>カテゴリー</dt>
  <dd><%= t("enums.spot.category.#{@spot.category}") %></dd>

  <% if official_url.present? %>
    <dt>公式サイト</dt>
    <dd>
      <%= link_to "公式サイトを見る",
                  official_url,
                  target: "_blank",
                  rel: "noopener noreferrer" %>
    </dd>
  <% end %>
</dl>

<% if user_signed_in? %>
  <div>
    <% if @favorite %>
      <%= button_to "★ お気に入りを解除する",
                    spot_favorite_path(@spot),
                    method: :delete %>
    <% else %>
      <%= button_to "☆ お気に入りに登録する",
                    spot_favorite_path(@spot),
                    method: :post %>
    <% end %>
  </div>

  <div>
    <% if @current_user_review %>
      <%= link_to "自分の口コミを編集する",
                  edit_spot_review_path(@spot, @current_user_review) %>

      <%= button_to "自分の口コミを削除する",
                    spot_review_path(@spot, @current_user_review),
                    method: :delete,
                    form: {
                      data: {
                        turbo_confirm: "本当にこの口コミを削除しますか？"
                      }
                    } %>
    <% else %>
      <%= link_to "このスポットの口コミを投稿する",
                  new_spot_review_path(@spot) %>
    <% end %>
  </div>
<% else %>
  <p>
    口コミの投稿やお気に入り登録をするには
    <%= link_to "ログイン", new_user_session_path %>
    してください。
  </p>
<% end %>

<section>
  <h2>口コミ一覧</h2>

  <% if @reviews.any? %>
    <% @reviews.each do |review| %>
      <article>
        <h3>
          <%= link_to review.user.name.presence || "名前未設定",
                      user_path(review.user) %>
          さんの口コミ
        </h3>

        <p>評価：<%= "★" * review.rating %></p>

        <% if review.image? %>
          <div>
            <%= image_tag review.image.url,
                          alt: "#{@spot.name}の口コミ画像",
                          style: "max-width: 100%; height: auto;" %>
          </div>
        <% end %>

        <p><%= review.body %></p>

        <% if review.good_point.present? %>
          <p>
            <strong>良かった点：</strong>
            <%= review.good_point %>
          </p>
        <% end %>

        <% if review.bad_point.present? %>
          <p>
            <strong>気になった点：</strong>
            <%= review.bad_point %>
          </p>
        <% end %>

        <dl>
          <dt>訪れた季節</dt>
          <dd><%= t("enums.review.season.#{review.season}") %></dd>

          <dt>旅行の目的</dt>
          <dd><%= t("enums.review.purpose.#{review.purpose}") %></dd>

          <dt>一緒に訪れた人</dt>
          <dd>
            <%= t("enums.review.companion_type.#{review.companion_type}") %>
          </dd>
        </dl>

        <p>投稿日：<%= review.created_at.strftime("%Y/%m/%d") %></p>
      </article>
    <% end %>
  <% else %>
    <p>まだ口コミはありません。</p>
  <% end %>
</section>

<%= link_to "スポット一覧に戻る", spots_path %>