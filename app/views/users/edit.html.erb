<main class="content-page form-page">
<h1>プロフィール編集</h1>

<% if @user.errors.any? %>
  <div>
    <h2>入力内容を確認してください</h2>

    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user do |form| %>
  <div>
    <%= form.label :name, "ユーザー名（任意・30文字以内）" %>
    <%= form.text_field :name, maxlength: 30 %>
  </div>

  <div>
    <%= form.label :residence, "居住地（任意・50文字以内）" %>
    <%= form.text_field :residence, maxlength: 50 %>
  </div>

  <div>
    <%= form.label :bio, "自己紹介（任意・500文字以内）" %>
    <%= form.text_area :bio, rows: 6, maxlength: 500 %>
  </div>

  <div>
    <%= form.submit "更新する" %>
  </div>
<% end %>

<%= link_to "プロフィールに戻る", user_path(@user) %>
</main>
